# Copy to .env and fill in. Never commit .env (SEC-06).
# Production values live in GitHub Actions Secrets and on the EC2 host only.

# Database (backend + local docker compose)
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Web origin allowed for cookies and WebSocket (SEC-03), e.g. http://localhost:5173 locally
APP_ORIGIN=

# Comma-separated admin emails (D-23)
ADMIN_EMAILS=

# Google OAuth (01-auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Moderation providers (07-moderation)
OPENAI_API_KEY=
KHUCHAT_API_KEY=
