{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./backend/.env)",
      "Edit(./frontend/.env)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.production)",
      "Write(./backend/.env)",
      "Write(./frontend/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-careful.sh\""
          }
        ]
      }
    ]
  }
}
