# 비밀값 (SEC-06) — .env 계열은 하나도 커밋하지 않음
.env
.env.*

# 빌드 산출물
backend/build/
backend/.gradle/
frontend/node_modules/
frontend/dist/

# ML: 모델 가중치, 학습 데이터, 추출본은 git에 넣지 않음 (D-40, SEC-17)
ml/**/models/
ml/**/data/
ml/**/exports/
ml/eval/sets/
# 외부 손글씨 데이터 (AI Hub 등, 재배포 금지): 로컬에만 둠
ml/OCR_samples/
*.pt
*.pth
*.onnx
*.safetensors
*.ckpt
__pycache__/
.pytest_cache/
.venv/
*.pyc

# 글꼴 원본 (대부분 파일 재배포 금지, D-44): 로컬에만 두고 scripts/build_fonts.py 결과만 커밋
frontend/designs/fonts/

# 보안 감사, QA 리포트의 원본 덤프 (요약은 docs/에 기록)
.qa-reports/

# OS, IDE
.DS_Store
.idea/
.vscode/
*.iml

# /gf-run 단계 기록과 요약 보고서 (로컬 전용)
.gf-run/
